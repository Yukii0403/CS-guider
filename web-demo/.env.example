# ============================================================
# 部署与模型密钥（可选，但推荐）
# ============================================================
# 什么情况下需要它：
#   - 如果你已经用 `npx wrangler login` 授权成功 —— Cloudflare 那一项不需要
#   - 如果 OAuth 登录失败（比如卡在 "Fetching auth token"）—— 用 API Token 绕开
#
# 用法：把本文件复制为 .env（同目录），填好即可。
#       wrangler 会自动读取**当前工作目录**下的 .env，
#       所以跑 wrangler 命令前一定要先 `cd` 到 web-demo/。
#
# 安全：.env 已在 .gitignore 中，不会被提交。仍然不要把它发给任何人。
# ============================================================


# ------------------------------------------------------------
# ① Cloudflare API Token —— 部署用
# ------------------------------------------------------------
# 获取：https://dash.cloudflare.com/profile/api-tokens
#       点 Create Token → 选 "Edit Cloudflare Workers" 模板
#       → Continue to summary → Create Token → 复制
#
# ⚠️ 这个值只在创建时显示一次。如果丢了，去同一页面 Roll 一下重新生成。
# ⚠️ 填写时等号后面不要加引号、不要留空格。
CLOUDFLARE_API_TOKEN=


# ------------------------------------------------------------
# ② 模型 API Key —— 运行时用（会被设成 Worker/Pages 的加密变量）
# ------------------------------------------------------------
# 获取：https://platform.deepseek.com/api_keys → 创建 API Key
#
# 这个值不会随代码提交，而是由部署脚本单独推送到 Cloudflare 并加密存储。
MODEL_API_KEY=


# ------------------------------------------------------------
# ③ 可选：换成别家模型（不填就用 DeepSeek 默认值）
# ------------------------------------------------------------
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
